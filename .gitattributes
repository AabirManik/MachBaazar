# Normalise line endings so `prettier` (endOfLine: "lf") passes on every platform.
# Without this, a Windows checkout with core.autocrlf=true turns every line into CRLF
# and produces thousands of false prettier/prettier errors.
* text=auto eol=lf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.mcpb binary
