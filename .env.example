# ─── Pixa configuration ──────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values you need.
# `.env` is gitignored — never commit real secrets.
# All values are optional: with no keys set the server runs in READ_ONLY mode
# (tools respond with an explanatory error instead of signing anything).

# ─── Active — Phase 2.5: Sui-only ────────────────────────────────────────────

# Sui ed25519 private key (suiprivkey1... or raw bytes).
# src/blockchain/sui/suiWallet.ts is the ONLY key holder — never log it,
# never pass it to the LLM.
SUI_PRIVATE_KEY=

# Default payment network: sui-testnet | sui-mainnet
NETWORK=sui-testnet

# Spending limits (USDC, decimal strings).
MAX_PER_CALL=0.10
MAX_PER_DAY=20.00

# ─── Upcoming — Phase 4: Tatum Sui RPC ───────────────────────────────────────
# Read + verify only. Tatum never signs and never settles payments.
TATUM_API_KEY=
TATUM_SUI_MAINNET_URL=
TATUM_SUI_TESTNET_URL=

# ─── Upcoming — Phase 5: Walrus Memory (MemWal) ──────────────────────────────
# Ed25519 delegate key (hex or suiprivkey1...) for the memory space.
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=
